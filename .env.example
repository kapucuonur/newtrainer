# Optional overrides (all free / self-hosted friendly)
VITE_OSRM_URL=https://router.project-osrm.org
VITE_ELEVATION_URL=https://api.opentopodata.org/v1/aster30m

# OpenFreeMap styles (free, no key): liberty | bright | positron | dark | fiord
# Default in app is liberty (colorful). dark is intentionally grayscale.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Free Mapillary street-level imagery during rides (Graph API v4 client token).
# 1) Create a free Mapillary account: https://www.mapillary.com/
# 2) Register an app at https://www.mapillary.com/dashboard/developers
# 3) Copy the Client Token and set it below (no Google / no billing).
# Leave unset to keep MapLibre follow-road camera only.
# VITE_MAPILLARY_ACCESS_TOKEN=

# Self-hosted ROADLAB API (Raspberry Pi + Cloudflare Tunnel).
# Leave unset for local-only mode (no cloud profile / save ride).
# Local:  VITE_API_URL=http://127.0.0.1:8788
# Prod:   VITE_API_URL=https://newtrainer-api.trihonor.com
# VITE_API_URL=
