# Optional overrides (all free / self-hosted friendly)
VITE_OSRM_URL=https://router.project-osrm.org
VITE_ELEVATION_URL=https://api.opentopodata.org/v1/aster30m

# OpenFreeMap styles (free, no key): liberty | bright | positron | dark | fiord
# Default in app is liberty (colorful). dark is intentionally grayscale.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional Google Street View Static imagery during rides (requires Maps API key + billing).
# Leave unset for free follow-camera immersion only (MapLibre pitch/bearing along the route).
# VITE_GOOGLE_MAPS_API_KEY=
